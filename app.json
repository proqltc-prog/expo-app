{
  "expo": {
    "name": "Famenu",
    "slug": "famenu",
    "scheme": "famenu",
    "version": "0.45.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.famenu.app"
    },
    "android": {
      "package": "be.famenu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e7d4f"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Famenu gebruikt de camera om barcodes van producten te scannen.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
