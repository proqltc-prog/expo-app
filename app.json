{
  "expo": {
    "name": "Famenu",
    "slug": "famenu",
    "scheme": "famenu",
    "version": "0.168.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.famenu.app"
    },
    "android": {
      "package": "be.famenu.app",
      "versionCode": 168000,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e7d4f"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withUploadSigning",
      "./plugins/withOptionalPortrait",
      [
        "expo-camera",
        {
          "cameraPermission": "Famenu gebruikt de camera om barcodes van producten te scannen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Famenu gebruikt je foto's enkel om een recept van een foto in te lezen.",
          "cameraPermission": "Famenu gebruikt de camera om barcodes te scannen en om een recept te fotograferen.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8394022188610476~8402661164",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/meldingen/kookwekker.png",
          "color": "#0F6B66"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png",
      "name": "Famenu"
    },
    "experiments": {
      "baseUrl": "/expo-app"
    }
  }
}
